# =========================================================================
# MOTOR-CRM - VARIABLES DE ENTORNO
# =========================================================================

# 1. SUPABASE
# Estas variables son requeridas por los clientes de Supabase (src/lib/supabase/)
NEXT_PUBLIC_SUPABASE_URL="tu-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-supabase-anon-key"

# (Sólo servidor) Clave de servicio para flujos administrativos que bypassean RLS si hiciera falta.
# SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# 2. WHATSAPP CLOUD API (META)
# Token arbitrario que configuras tú mismo en el panel de Meta para verificar el webhook
WHATSAPP_VERIFY_TOKEN="mi_token_secreto_para_whatsapp"
# Token permanente o temporal de acceso de Meta para enviar mensajes de vuelta
WHATSAPP_API_TOKEN="tu-token-permanente-de-meta"
# ID de tu número de teléfono en WhatsApp Cloud API
WHATSAPP_PHONE_ID="1234567890"

